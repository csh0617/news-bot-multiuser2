# --- Supabase (필수) ---
SUPABASE_URL=https://rqusufmignjipgdsjhxn.supabase.co
# 서버 워커는 service_role 키 권장(RLS 우회). 클라이언트에 노출 금지!
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=rqusufmignjipgdsjhxn

# --- 뉴스 소스: 네이버 검색 OpenAPI (선택, 없으면 HTML 스크래핑 폴백) ---
# https://developers.naver.com/apps  에서 발급 (검색 API)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 스케줄/수집량 (선택) ---
LOOP_INTERVAL_SECONDS=1800
ARTICLES_PER_POLITICIAN=20
DEFAULT_CRAWL_INTERVAL_HOURS=6
MAX_POLITICIANS_PER_RUN=50
FETCH_FULL_CONTENT=false

# --- 분류 임계값 (선택, 튜닝용) ---
DISAMBIG_THRESHOLD=1.0
RELEVANCE_SUBJECT_THRESHOLD=0.45
RELEVANCE_MENTION_THRESHOLD=0.15
SENTIMENT_NEUTRAL_BAND=0.12
# 단순 언급(mention) 기사도 저장할지 (기본 false: 주체 기사만 저장)
SAVE_MENTIONS=false

# --- 선택: 텔레그램 알림 (주체 기사만) ---
TELEGRAM_NOTIFY=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
